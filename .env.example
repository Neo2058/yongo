# Owner bootstrap. Used only when the users table is empty.
# Use a unique random password of 12–256 characters.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me-at-least-10

# Public origin for sitemap, robots and invite links.
SITE_URL=http://localhost:3000

# Enable ONLY behind a private proxy which overwrites X-Real-IP.
TRUST_PROXY=0

# Optional. After a lead/order is saved, notify the owner.
# If SMTP_HOST is empty, the app logs "SMTP не настроен" and keeps the DB row.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# MAIL_TO defaults to OWNER_EMAIL
MAIL_TO=

# Backups: keep 7 complete snapshots by default. In Docker, use a mounted path.
BACKUP_KEEP=7
# BACKUP_DIR=/app/data/backups
